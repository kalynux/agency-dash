# ──────────────────────────────────────────────────────────────────────────────
# Development environment — loaded automatically by Vite for `npm run dev`.
# Non-secret localhost defaults; safe to commit.
# Put personal / real tokens in  env/.env.development.local  (git-ignored).
# ──────────────────────────────────────────────────────────────────────────────

# wimall backend (Express + MongoDB) — all /api calls go here.
VITE_API_BASE_URL=http://localhost:8022/api/

# Base URL where uploaded files are served (defaults to the API origin /uploads).
# VITE_FILE_BASE_URL=

# App display name (documented default).
VITE_APP_NAME=WiMall Agency

# ─── Live tracking (geo-tracker, the separate Go WebSocket service) ─────────────
# WebSocket endpoint that streams agent positions.
VITE_GEO_TRACKER_WS_URL=ws://localhost:8090/ws/track

# OPTIONAL — bearer-token OVERRIDE for the geo-tracker WS.
# By default we DON'T need this in dev: the browser forwards the httpOnly
# access_token cookie on the WS handshake automatically (same-site — cookies
# ignore port), exactly like credentials:'include' on fetch. Leave this blank and
# the cookie authenticates the socket.
# Only set it when geo-tracker runs on a DIFFERENT site/domain than the app (a
# SameSite=Lax cookie won't be sent cross-site there). Value must be a valid
# agency access_token JWT. Prefer env/.env.development.local for real tokens.
VITE_GEO_TRACKER_TOKEN=
# Vendor Dashboard — environment variables (Vite). Copy to `.env` and fill in.

# Stripe publishable key (pk_test_… / pk_live_…). Enables card payments for plan
# upgrades and credit top-ups. When unset, the billing UI offers mobile money only.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51Tl7mmBKKsBJNpBM0qQhxtwhErakLmTWGXJldimCmBLZffb54KCFchgDbMtpkdra7VLP00rr9WE9Gxqjjqe6z0XB00dsQQ2N6P
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51TlJuhBjHkF8RUAji782u5NqprMkU9vdwtWpFOw0wfbIWcQKVqjeXyaJBuge0hiUchY7PbEwTizhqcvo90KqyTud00QHEYztv8

# ─── Push notifications (FCM web push) ────────────────────────────────────────
# Firebase Web SDK config for the MESSAGING Firebase project (separate from the
# file-storage project). Get these from: Project settings → General → Web app,
# and the VAPID key from Cloud Messaging → Web Push certificates → Key pair.
# When ANY of these are unset, push stays inert (in-app notifications still work).
# NOTE: keep these in sync with the hardcoded config in
# public/firebase-messaging-sw.js (the service worker can't read Vite env vars).
VITE_FIREBASE_API_KEY=AIzaSyBEm8btwePIHHYpSs41zebr6KmHIuWinA0
VITE_FIREBASE_AUTH_DOMAIN=bingoo-22222.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bingoo-22222
VITE_FIREBASE_MESSAGING_SENDER_ID=741831724264
VITE_FIREBASE_APP_ID=1:741831724264:web:6741494f37bd0bd0d34d5d
VITE_FIREBASE_VAPID_KEY=BCnGJqU4hsphcmSNMlMUuwcKIDbvKXIU8lF85ylFCkIgrLbBOE9G6-Idq5xVhiFWbY_DdGmLUZSc309gBZo5-gA
