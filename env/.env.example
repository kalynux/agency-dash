# ──────────────────────────────────────────────────────────────────────────────
# Environment variable reference (template). Copy the value you need into
#   env/.env.development         (dev defaults, committed)
#   env/.env.development.local   (your personal / secret overrides, git-ignored)
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED — wi-mall backend base URL (must end in /api).
VITE_API_BASE_URL=http://localhost:8022/api

# OPTIONAL — app display name.
VITE_APP_NAME=Wi-Agency

# OPTIONAL — where `/login` redirects. Login lives on the main Wi-Mall site, so
# this is the landing app in dev and https://wi-mall.com/login in production.
VITE_LOGIN_URL=http://localhost:3000/login

# OPTIONAL — this app's own address on the web. Read only by a NATIVE build:
# billing is read-only on mobile, so plan changes and credit top-ups point here.
# Defaults to https://agency.wi-mall.com.
# VITE_WEB_DASHBOARD_URL=https://agency.wi-mall.com

# OPTIONAL — geo-tracker live-tracking WebSocket URL.
VITE_GEO_TRACKER_WS_URL=ws://localhost:8090/ws/track

# OPTIONAL — geo-tracker HTTP origin (travelled-path trail + road routing).
# Defaults to the origin of VITE_GEO_TRACKER_WS_URL; set only if they differ.
# VITE_GEO_TRACKER_URL=http://localhost:8090

# OPTIONAL (needed only to test Live Tracking) — a valid agency access_token JWT
# used as the geo-tracker WS bearer. Comes from the backend (login response /
# session). Alternatively inject window.wiMallGetAccessToken() at runtime.
VITE_GEO_TRACKER_TOKEN=

# ─── Live Tracking basemap (Leaflet) ──────────────────────────────────────────
# OPTIONAL — override the map tile provider. Leave unset to use the built-in
# default (CARTO, keyless, with light + dark styles). Set VITE_MAP_TILE_URL to a
# Leaflet URL template ({s}/{z}/{x}/{y}, optional {r} for retina) to point at any
# other provider without a code change; the other two refine that override.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_URL_DARK=
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Vendor Dashboard — environment variables (Vite). Copy to `.env` and fill in.

# Base URL where uploaded files are served (defaults to the API origin /uploads).
# VITE_FILE_BASE_URL=

# Stripe publishable key (pk_test_… / pk_live_…). Enables card payments for plan
# upgrades and credit top-ups. When unset, the billing UI offers mobile money only.
# VITE_STRIPE_PUBLISHABLE_KEY=qxwX
VITE_STRIPE_PUBLISHABLE_KEY=cwcwxc

# ─── Mobile (Capacitor) ───────────────────────────────────────────────────────
# DEV-ONLY — force the mobile auth transport (bearer tokens against
# /api/auth/mobile/*) in a desktop browser, for testing the native path without a
# device. Only honoured when the dev server is running; a production build inlines
# it away. Best set in env/.env.development.local.
# VITE_FORCE_MOBILE_AUTH=true

# ─── Push notifications (FCM web push) ────────────────────────────────────────
# Firebase Web SDK config for the MESSAGING Firebase project (separate from the
# file-storage project). Get these from: Project settings → General → Web app,
# and the VAPID key from Cloud Messaging → Web Push certificates → Key pair.
# When ANY of these are unset, push stays inert (in-app notifications still work).
# NOTE: keep these in sync with the hardcoded config in
# public/firebase-messaging-sw.js (the service worker can't read Vite env vars).
VITE_FIREBASE_API_KEY=XKcwdcvkx
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=1
VITE_FIREBASE_VAPID_KEY=
